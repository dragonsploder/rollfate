[gd_scene format=3 uid="uid://dgx0qyswusuuc"]

[ext_resource type="PackedScene" uid="uid://cdxr6xt3qgajk" path="res://scenes/main.tscn" id="1_n87rw"]

[sub_resource type="GDScript" id="GDScript_cu0mx"]
script/source = "extends CanvasLayer

@export var start_volume : float = 0.8
@onready var volume_slider: HSlider = $Control/PanelContainer/MarginContainer/VBoxContainer/HBoxContainer/VolumeSlider
@onready var volume_sfx_slider: HSlider = $Control/PanelContainer/MarginContainer/VBoxContainer/HBoxContainer2/VolumeSlider

@export var main: PackedScene

func _ready() -> void:
	volume_slider.value = start_volume
	volume_sfx_slider.value = start_volume
	_on_volume_slider_value_changed(start_volume)
	_on_volume_sfx_slider_value_changed(start_volume)

func _on_volume_slider_value_changed(value: float) -> void:
	AudioServer.set_bus_volume_linear(AudioServer.get_bus_index(\"MUSIC\"), value)

func _on_exit_pressed() -> void:
	get_tree().paused = false
	get_tree().reload_current_scene()
	
func _on_return_pressed() -> void:
	get_tree().paused = false
	hide()


func _on_volume_sfx_slider_value_changed(value: float) -> void:
	AudioServer.set_bus_volume_linear(AudioServer.get_bus_index(\"SFX\"), value)
"

