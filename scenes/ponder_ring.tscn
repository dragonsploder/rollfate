[sub_resource type="GDScript" id="GDScript_uahpa"]
script/source = "extends Node2D

# The total amount of time it takes for the rhythm to loop
const RHYTHM_TIME = 3

# The delay before the next ring in tandem should start
@export var next_ring_step : float

@onready var planet = get_parent().get_parent()

# the stage of the rythm we are currently in
var dt : float = 0

var can_grow : bool = false
	
func get_next_ring_step():
	return next_ring_step

# no matter what, the rings will keep updating to the current size of the planet
func begin_grow(delay : float):
	$DelayTimer.start(delay)
	await $DelayTimer.timeout
	can_grow = true
	visible = true

func reset():
	$DelayTimer.stop()
	cull()
	can_grow = false
	visible = false

# we need a way reset the size of the ring without stopping it from growing
func cull():
	dt = 0
	scale = Vector2.ZERO

# As long as we are able to grow, the rings should expand outward
func _process(delta: float) -> void:
	if (can_grow):
		dt += delta
		dt = fmod(dt, RHYTHM_TIME)
		scale = dt * planet.scale / RHYTHM_TIME
"

